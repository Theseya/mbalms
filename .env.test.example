# Copy to .env.test and set the password locally. Never commit .env.test.
# This file is only for docker-compose.test.yml (project mbalms-test).
# It does not configure the live mbalms stack.

TEST_POSTGRES_DB=check
TEST_POSTGRES_USER=check
TEST_POSTGRES_PASSWORD=
TEST_DB_PORT=55433
# Application database on this cluster (created by scripts/up-test-db.ps1).
TEST_APP_DATABASE=worksheet_manual

