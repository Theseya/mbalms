# Copy to .env and set your own values. Never commit .env.

# PostgreSQL
POSTGRES_DB=mbalms
POSTGRES_USER=mbalms
POSTGRES_PASSWORD=change-me-strong-password
# Host port for PostgreSQL (localhost only). 5433 avoids clashing with a locally installed PostgreSQL.
DB_PORT=5433

# Application
APP_TIMEZONE=Europe/Moscow
PROGRAM_NAME=MBA
WEB_PORT=8080
# Always = cookies only over HTTPS (production). SameAsRequest = also plain HTTP (local run).
AUTH_COOKIE_SECURE_POLICY=SameAsRequest

# Initial manager account, created on first start if it does not exist.
# Password: at least 8 characters with a digit, a lowercase and an uppercase letter.
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=
